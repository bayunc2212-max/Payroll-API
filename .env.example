# Copy file ini menjadi .env dan isi dengan nilai yang sesuai
# JANGAN commit file .env ke repository

# Server
PORT=3000
NODE_ENV=development

# Database - MySQL (dbngin local)
# Contoh: mysql://root:password@localhost:3306/payroll
DATABASE_URL=mysql://root:root@localhost:3306/payroll

# JWT - Ganti dengan string random yang kuat!
JWT_SECRET=ganti-dengan-string-random-minimal-32-karakter
JWT_REFRESH_SECRET=ganti-dengan-string-random-lain-minimal-32-karakter

# Email - Konfigurasi SMTP
# Untuk Gmail: gunakan App Password (bukan password biasa)
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=email-anda@gmail.com
SMTP_PASS=app-password-gmail-anda
SMTP_FROM=Sistem Payroll <email-anda@gmail.com>

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
